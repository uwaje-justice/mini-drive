<%- include("../partials/header", { title: `Edit ${file.name}` }) %>

<div class="form-page">
  <a class="back-link" href="/files/<%= file.id %>">
    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="m15 6-6 6 6 6"></path>
    </svg>
    Back
  </a>

  <div class="page-header">
    <div>
      <p class="eyebrow">File settings</p>
      <h1>Edit file</h1>
      <p class="page-header__meta">Rename this file or move it to another folder.</p>
    </div>
  </div>

  <section class="panel form-panel" aria-labelledby="rename-title">
    <h2 id="rename-title">Rename</h2>

    <% if (errors?.name) { %>
      <p class="form-alert" role="alert">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <circle cx="12" cy="12" r="9"></circle>
          <path d="M12 7.5v5.5M12 16.5h.01"></path>
        </svg>
        <span><%= errors.name %></span>
      </p>
    <% } %>

    <form class="form" action="" method="post" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="folderId" value="<%= values?.folderId ?? "" %>">
      <div class="form-field">
        <label for="name">File name</label>
        <input id="name" name="name" type="text" maxlength="255" value="<%= values?.name ?? "" %>" required<% if (errors?.name) { %> aria-invalid="true" aria-describedby="name-error"<% } %>>
        <% if (errors?.name) { %><p class="field-error" id="name-error"><%= errors.name %></p><% } %>
      </div>
      <div class="form-actions">
        <button class="button button--primary" type="submit">Save name</button>
      </div>
    </form>
  </section>

  <section class="panel form-panel" aria-labelledby="move-title">
    <h2 id="move-title">Move</h2>

    <% if (errors?.folderId) { %>
      <p class="form-alert" role="alert">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <circle cx="12" cy="12" r="9"></circle>
          <path d="M12 7.5v5.5M12 16.5h.01"></path>
        </svg>
        <span><%= errors.folderId %></span>
      </p>
    <% } %>

    <form class="form" action="/files/<%= file.id %>/move" method="post" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="name" value="<%= values?.name ?? file.name %>">
      <div class="form-field">
        <label for="folderId">Destination</label>
        <select id="folderId" name="folderId"<% if (errors?.folderId) { %> aria-invalid="true" aria-describedby="folder-error"<% } %>>
          <% targets.forEach((target) => { %>
            <option value="<%= target.id ?? "" %>" <%= String(target.id ?? "") === String(values?.folderId ?? "") ? "selected" : "" %>>
              <%= `${"— ".repeat(target.depth)}${target.path}` %>
            </option>
          <% }); %>
        </select>
        <% if (errors?.folderId) { %><p class="field-error" id="folder-error"><%= errors.folderId %></p><% } %>
      </div>
      <div class="form-actions">
        <button class="button button--primary" type="submit">Move</button>
        <a class="text-button" href="/files/<%= file.id %>">Cancel</a>
      </div>
    </form>
  </section>
</div>

<%- include("../partials/footer") %>
