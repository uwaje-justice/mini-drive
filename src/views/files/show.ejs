<%- include("../partials/header", { title: file.name }) %>
<p>
  <a href="<%= file.folderId ? `/folders/${file.folderId}` : "/folders" %>">Back</a>
</p>
<h1><%= file.name %></h1>

<dl>
  <dt>Size</dt>
  <dd><%= formatBytes(file.size) %></dd>
  <dt>Type</dt>
  <dd><%= file.mimeType %></dd>
  <dt>Uploaded</dt>
  <dd><%= file.createdAt.toUTCString() %></dd>
  <dt>Folder</dt>
  <dd>
    <% if (file.folder) { %>
      <a href="/folders/<%= file.folder.id %>"><%= file.folder.name %></a>
    <% } else { %>
      My drive
    <% } %>
  </dd>
</dl>

<% if (isPreviewable(file.mimeType)) { %>
  <section>
    <h2>Preview</h2>
    <% if (file.mimeType.startsWith("image/")) { %>
      <img src="/files/<%= file.id %>/preview" alt="<%= file.name %>">
    <% } else { %>
      <iframe src="/files/<%= file.id %>/preview" title="Preview of <%= file.name %>"></iframe>
    <% } %>
  </section>
<% } %>

<p>
  <a href="/files/<%= file.id %>/download">Download</a>
  <a href="/files/<%= file.id %>/edit">Rename or move</a>
</p>

<form action="/files/<%= file.id %>/delete" method="post" onsubmit="return confirm('Delete this file?')">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <button type="submit">Delete file</button>
</form>

<%- include("../partials/footer") %>
