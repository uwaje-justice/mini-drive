<%
  const mime = typeof mimeType !== "undefined" && mimeType ? String(mimeType) : "";
  const isImage = mime.startsWith("image/");
  const isPdf = mime === "application/pdf";
  const isText = mime.startsWith("text/") || /(json|xml|javascript|csv|sql)/.test(mime);
  const iconClass = typeof extraClass !== "undefined" && extraClass ? ` ${extraClass}` : "";
  let kind = "file";
  if (isImage) kind = "image";
  else if (isPdf) kind = "pdf";
  else if (isText) kind = "text";
%>
<svg class="file-icon file-icon--<%= kind %><%= iconClass %>" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
  <% if (isImage) { %>
    <rect x="3.5" y="4.5" width="17" height="15" rx="2.5" fill="currentColor" opacity="0.14"></rect>
    <rect x="3.5" y="4.5" width="17" height="15" rx="2.5" stroke="currentColor" stroke-width="1.5"></rect>
    <circle cx="8.5" cy="9.5" r="1.5" fill="currentColor"></circle>
    <path d="m4 17 5.2-5.2 4.1 4.1 2.8-2.8L20 17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
  <% } else if (isPdf) { %>
    <path d="M6 3.5h7.5L19 9v11.5H6z" fill="currentColor" opacity="0.12"></path>
    <path d="M6 3.5h7.5L19 9v11.5H6z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path>
    <path d="M13.5 3.5V9H19M9 13h5.5M9 16.5h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
  <% } else if (isText) { %>
    <path d="M6 3.5h7.5L19 9v11.5H6z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path>
    <path d="M13.5 3.5V9H19M9 12.5h6M9 15.5h6M9 18.5h3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
  <% } else { %>
    <path d="M6 3.5h7.5L19 9v11.5H6z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path>
    <path d="M13.5 3.5V9H19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
  <% } %>
</svg>
