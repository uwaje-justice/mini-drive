<%
  const visualHeading = typeof authHeading !== "undefined"
    ? authHeading
    : "A calmer place for your files.";
  const visualLead = typeof authLead !== "undefined"
    ? authLead
    : "Everything you need, without the clutter.";
%>
<aside class="auth-visual" aria-hidden="true">
  <div class="auth-visual__top">
    <span class="auth-visual__brand">
      <%- include("brand-mark", { markClass: "auth-visual__mark" }) %>
      <span>mini drive</span>
    </span>
  </div>

  <div class="auth-visual__content">
    <p class="auth-visual__heading"><%= visualHeading %></p>
    <p class="auth-visual__lead"><%= visualLead %></p>
  </div>

  <div class="auth-stack">
    <div class="auth-stack__card auth-stack__card--folder">
      <span class="auth-stack__icon auth-stack__icon--yellow">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 7.5A2.5 2.5 0 0 1 5.5 5h4l2 2.5h7A2.5 2.5 0 0 1 21 10v7.5a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 17.5v-10Z"></path>
        </svg>
      </span>
      <span class="auth-stack__text">
        <strong>Projects</strong>
        <span>4 items</span>
      </span>
    </div>

    <div class="auth-stack__card auth-stack__card--file">
      <span class="auth-stack__icon auth-stack__icon--red">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5Z"></path>
          <path d="M14 3v5h5"></path>
          <path d="M9 13h6M9 17h4"></path>
        </svg>
      </span>
      <span class="auth-stack__text">
        <strong>Notes.txt</strong>
        <span>2.4 KB</span>
      </span>
    </div>

    <div class="auth-stack__card auth-stack__card--share">
      <span class="auth-stack__icon auth-stack__icon--blue">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M10 13.5a4 4 0 0 0 5.7 0l2.8-2.8a4 4 0 1 0-5.7-5.7L11.5 6.3"></path>
          <path d="M14 10.5a4 4 0 0 0-5.7 0l-2.8 2.8a4 4 0 1 0 5.7 5.7l1.3-1.3"></path>
        </svg>
      </span>
      <span class="auth-stack__text">
        <strong>Share link</strong>
        <span>Expires in 7 days</span>
      </span>
    </div>
  </div>

  <p class="auth-visual__note">
    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <rect x="5" y="10" width="14" height="10" rx="2"></rect>
      <path d="M8 10V7a4 4 0 0 1 8 0v3"></path>
    </svg>
    Private by default. Share only what you choose.
  </p>
</aside>
