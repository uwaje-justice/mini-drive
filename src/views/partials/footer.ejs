      <div class="container site-footer__inner">
        <div>
          <a class="brand" href="/" aria-label="mini drive home">
            <%- include("brand-mark", { markClass: "brand__mark" }) %>
            <span>mini drive</span>
          </a>
          <p class="site-footer__note">A simple personal drive for everyday files.</p>
        </div>
        <nav class="site-footer__nav" aria-label="Footer">
          <a href="#features">Features</a>
          <a href="#how-it-works">How it works</a>
          <a href="#privacy">Privacy</a>
          <% if (typeof currentUser !== "undefined" && currentUser) { %>
            <a href="/folders">My drive</a>
          <% } else { %>
            <a href="/auth/login">Log in</a>
            <a href="/auth/register">Register</a>
          <% } %>
        </nav>
        <p class="site-footer__note">© <%= new Date().getFullYear() %> mini drive</p>
      </div>
    </footer>
  <% } %>
</body>
</html>
