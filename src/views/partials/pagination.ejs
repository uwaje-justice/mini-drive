<% if (pagination.totalPages > 1) { %>
  <%
    const makeLink = (page) => {
      const params = new URLSearchParams(typeof query !== "undefined" ? query : {});
      params.set(paramName, page);
      return `${basePath}?${params.toString()}`;
    };
  %>
  <nav class="pagination" aria-label="<%= label %>">
    <% if (pagination.hasPrevious) { %>
      <a class="pagination__link" href="<%= makeLink(pagination.page - 1) %>">Previous</a>
    <% } else { %>
      <span class="pagination__link is-disabled" aria-disabled="true">Previous</span>
    <% } %>
    <span class="pagination__status">Page <%= pagination.page %> of <%= pagination.totalPages %></span>
    <% if (pagination.hasNext) { %>
      <a class="pagination__link" href="<%= makeLink(pagination.page + 1) %>">Next</a>
    <% } else { %>
      <span class="pagination__link is-disabled" aria-disabled="true">Next</span>
    <% } %>
  </nav>
<% } %>
