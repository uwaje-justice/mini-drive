<%
  const searchValue = typeof query !== "undefined" && typeof query.q === "string" ? query.q : "";
%>
<header class="app-topbar">
  <form class="app-search" action="/search" method="get" role="search">
    <svg class="app-search__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true" focusable="false">
      <circle cx="10.5" cy="10.5" r="6.5"></circle>
      <path d="m15.5 15.5 4 4"></path>
    </svg>
    <label class="visually-hidden" for="app-search">Search files and folders</label>
    <input id="app-search" type="search" name="q" value="<%= searchValue %>" placeholder="Search files and folders" autocomplete="off">
    <button class="button button--primary button--small" type="submit">Search</button>
  </form>
</header>
