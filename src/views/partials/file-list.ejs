<% const base = typeof fileBasePath !== "undefined" ? fileBasePath : "/files"; %>
<% const showDetails = typeof fileDetails !== "undefined" ? fileDetails : true; %>
<% if (files.length > 0) { %>
  <div class="file-list" role="list">
    <% files.forEach((file) => { %>
      <div class="file-row" role="listitem">
        <span class="file-row__icon" aria-hidden="true">
          <%- include("file-icon", { mimeType: file.mimeType }) %>
        </span>
        <div class="file-row__main">
          <% if (showDetails) { %>
            <a class="file-row__name" href="<%= base %>/<%= file.id %>" title="<%= file.name %>"><%= file.name %></a>
          <% } else { %>
            <span class="file-row__name" title="<%= file.name %>"><%= file.name %></span>
          <% } %>
          <span class="file-row__meta">
            <span><%= formatBytes(file.size) %></span>
            <% if (showDetails) { %>
              <span aria-hidden="true">·</span>
              <time datetime="<%= file.createdAt.toISOString() %>"><%= file.createdAt.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }) %></time>
            <% } %>
          </span>
        </div>
        <div class="file-row__actions">
          <% if (!showDetails && isPreviewable(file.mimeType)) { %>
            <a class="file-row__action" href="<%= base %>/<%= file.id %>/preview">Preview</a>
          <% } %>
          <a class="file-row__action" href="<%= base %>/<%= file.id %>/download">Download</a>
        </div>
      </div>
    <% }); %>
  </div>
<% } else { %>
  <div class="empty-state">
    <span class="empty-state__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" focusable="false">
        <path d="M6 3.5h7.5L19 9v11.5H6z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path>
        <path d="M13.5 3.5V9H19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </span>
    <p>No files here yet.</p>
  </div>
<% } %>
