<%
  const path = typeof currentPath !== "undefined" ? currentPath : "";
  const activeFolderId = typeof folder !== "undefined" && folder ? folder.id : null;
  const onDrive = path === "/folders" || path.startsWith("/folders/") || path.startsWith("/files/");
  const onSearch = path === "/search";
  const uploadHref = activeFolderId ? `/folders/${activeFolderId}#upload` : "/folders#upload";
  const newFolderHref = activeFolderId ? `/folders/new?parentId=${activeFolderId}` : "/folders/new";
  const accountEmail = typeof currentUser !== "undefined" && currentUser ? currentUser.email : "";
  const accountInitial = accountEmail ? accountEmail.charAt(0).toUpperCase() : "?";
%>
<aside class="app-sidebar">
  <a class="app-brand" href="/folders" aria-label="mini drive home">
    <%- include("brand-mark", { markClass: "app-brand__mark" }) %>
    <span class="app-brand__name">mini drive</span>
  </a>

  <div class="app-sidebar__actions">
    <a class="button button--primary button--small" href="<%= newFolderHref %>">
      <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="M12 5v14M5 12h14"></path>
      </svg>
      New folder
    </a>
    <a class="button button--secondary button--small" href="<%= uploadHref %>">
      <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="M12 16V4m0 0L7 9m5-5 5 5"></path>
        <path d="M5 15v3a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-3"></path>
      </svg>
      Upload files
    </a>
  </div>

  <nav class="app-nav" aria-label="Main">
    <a class="app-nav__link<%= onDrive ? " is-active" : "" %>" href="/folders"<% if (onDrive) { %> aria-current="page"<% } %>>
      <svg class="app-nav__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="M3.5 7.5a2 2 0 0 1 2-2h4l2 2h7a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-13a2 2 0 0 1-2-2z"></path>
      </svg>
      My drive
    </a>
    <a class="app-nav__link<%= onSearch ? " is-active" : "" %>" href="/search"<% if (onSearch) { %> aria-current="page"<% } %>>
      <svg class="app-nav__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <circle cx="10.5" cy="10.5" r="6.5"></circle>
        <path d="m15.5 15.5 4 4"></path>
      </svg>
      Search
    </a>
  </nav>

  <div class="app-sidebar__spacer"></div>

  <div class="app-account">
    <span class="app-account__avatar" aria-hidden="true"><%= accountInitial %></span>
    <div class="app-account__text">
      <span class="app-account__label">Signed in as</span>
      <span class="app-account__email" title="<%= accountEmail %>"><%= accountEmail %></span>
    </div>
    <form action="/auth/logout" method="post">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="text-button app-account__logout" type="submit">Log out</button>
    </form>
  </div>
</aside>
