<% const base = typeof folderBasePath !== "undefined" ? folderBasePath : "/folders"; %>
<% if (folders.length > 0) { %>
  <ul>
    <% folders.forEach((folder) => { %>
      <li><a href="<%= base %>/<%= folder.id %>"><%= folder.name %></a></li>
    <% }); %>
  </ul>
<% } else { %>
  <p>No folders here yet.</p>
<% } %>
