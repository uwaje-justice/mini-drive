<%- include("../partials/header", { title: "Search" }) %>

<div class="page-header">
  <div>
    <p class="eyebrow">Find anything</p>
    <h1>Search</h1>
    <p class="page-header__meta">Search across every folder and file in your drive.</p>
  </div>
</div>

<% if (searchQuery) { %>
  <p class="search-summary"><%= results.length %> of <%= pagination.total %> results for "<%= searchQuery %>"</p>

  <% if (results.length === 0) { %>
    <div class="empty-state empty-state--search">
      <span class="empty-state__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" focusable="false">
          <circle cx="10.5" cy="10.5" r="6.5"></circle>
          <path d="m15.5 15.5 4 4"></path>
        </svg>
      </span>
      <p>No folders or files match that name.</p>
    </div>
  <% } else { %>
    <div class="search-results">
      <% results.forEach((result) => { %>
        <a class="search-result" href="<%= result.type === "folder" ? `/folders/${result.id}` : `/files/${result.id}` %>">
          <span class="search-result__icon" aria-hidden="true">
            <% if (result.type === "folder") { %>
              <svg class="file-icon file-icon--folder" viewBox="0 0 24 24" fill="none" focusable="false">
                <path d="M3.5 7.5a2 2 0 0 1 2-2h4l2 2h7a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-13a2 2 0 0 1-2-2z" fill="currentColor" opacity="0.18"></path>
                <path d="M3.5 7.5a2 2 0 0 1 2-2h4l2 2h7a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-13a2 2 0 0 1-2-2z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path>
              </svg>
            <% } else { %>
              <%- include("../partials/file-icon", { mimeType: result.mimeType }) %>
            <% } %>
          </span>
          <span class="search-result__main">
            <span class="search-result__name" title="<%= result.name %>"><%= result.name %></span>
            <span class="search-result__path"><%= result.path %></span>
          </span>
          <span class="search-result__meta">
            <span class="type-chip"><%= result.type %></span>
            <% if (result.size !== null) { %>
              <span><%= formatBytes(result.size) %></span>
            <% } %>
          </span>
        </a>
      <% }); %>
    </div>
  <% } %>

  <%- include("../partials/pagination", { pagination, paramName: "page", basePath: "/search", label: "Search pages" }) %>
<% } else { %>
  <div class="empty-state empty-state--search">
    <span class="empty-state__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" focusable="false">
        <circle cx="10.5" cy="10.5" r="6.5"></circle>
        <path d="m15.5 15.5 4 4"></path>
      </svg>
    </span>
    <p>Search your drive by name. Results appear here.</p>
  </div>
<% } %>

<%- include("../partials/footer") %>
