<%- include("../partials/header", { title: `Shared: ${folder.name}` }) %>
<% if (folder.id !== share.folderId) { %>
  <p><a href="/share/<%= share.token %>/folders/<%= folder.parentId %>">Back</a></p>
<% } %>
<nav aria-label="Breadcrumb">
  <ol>
    <% breadcrumbs.forEach((crumb, index) => { %>
      <li>
        <% if (crumb.id === null) { %>
          <a href="/share/<%= share.token %>">My drive</a>
        <% } else if (index < breadcrumbs.length - 1) { %>
          <a href="/share/<%= share.token %>/folders/<%= crumb.id %>"><%= crumb.name %></a>
        <% } else { %>
          <span><%= crumb.name %></span>
        <% } %>
      </li>
    <% }); %>
  </ol>
</nav>
<h1><%= folder.name %></h1>
<p>This folder is shared with you. You can view and download its files.</p>

<% const shareBasePath = folder.id === share.folderId ? `/share/${share.token}` : `/share/${share.token}/folders/${folder.id}`; %>

<section>
  <h2>Folders</h2>
  <%- include("../partials/folder-list", { folders, folderBasePath: `/share/${share.token}/folders` }) %>
  <%- include("../partials/pagination", { pagination: folderPagination, paramName: "folderPage", basePath: shareBasePath, label: "Folder pages" }) %>
</section>

<section>
  <h2>Files</h2>
  <%- include("../partials/file-list", { files, fileBasePath: `/share/${share.token}/files`, fileDetails: false }) %>
  <%- include("../partials/pagination", { pagination: filePagination, paramName: "page", basePath: shareBasePath, label: "File pages" }) %>
</section>

<%- include("../partials/footer") %>
