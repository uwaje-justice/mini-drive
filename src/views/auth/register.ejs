<%- include("../partials/header", {
  title: "Create account — mini drive",
  description: "Create a private personal drive for your files.",
  authPage: true
}) %>

<div class="auth-shell">
  <%- include("../partials/auth-visual", {
    authHeading: "A calmer place for your files.",
    authLead: "Start with an empty drive. Add folders, upload files, and share only what you choose."
  }) %>

  <section class="auth-panel" aria-labelledby="auth-title">
    <div class="auth-panel__inner">
      <a class="auth-back" href="/">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <path d="M19 12H5m0 0 6-6m-6 6 6 6"></path>
        </svg>
        Back to home
      </a>

      <p class="auth-kicker">Get started</p>
      <h1 id="auth-title">Create your drive.</h1>
      <p class="auth-lead">Start with an empty drive and make it yours.</p>

      <div class="form-alert" data-form-error role="alert" tabindex="-1"<% if (!errors?.form) { %> hidden<% } %>>
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <circle cx="12" cy="12" r="9"></circle>
          <path d="M12 8v5"></path>
          <path d="M12 16.5h.01"></path>
        </svg>
        <span data-form-error-text><%= errors?.form ?? "" %></span>
      </div>

      <form class="auth-form" action="/auth/register" method="post" data-auth-form="register" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="form-field">
          <label for="email">Email</label>
          <input
            id="email"
            name="email"
            data-auth-field
            type="email"
            autocomplete="email"
            spellcheck="false"
            autocapitalize="none"
            value="<%= values?.email ?? "" %>"
            aria-describedby="email-error"
            aria-invalid="<%= errors?.email ? "true" : "false" %>"
            required
          >
          <p class="field-error" id="email-error" data-error-for="email" aria-live="polite"<% if (!errors?.email) { %> hidden<% } %>><%= errors?.email ?? "" %></p>
        </div>

        <div class="form-field">
          <label for="password">Password</label>
          <input
            id="password"
            name="password"
            data-auth-field
            type="password"
            autocomplete="new-password"
            minlength="8"
            maxlength="128"
            aria-describedby="password-help password-error"
            aria-invalid="<%= errors?.password ? "true" : "false" %>"
            required
          >
          <p class="field-help" id="password-help">Use 8 to 128 characters.</p>
          <p class="field-error" id="password-error" data-error-for="password" aria-live="polite"<% if (!errors?.password) { %> hidden<% } %>><%= errors?.password ?? "" %></p>
        </div>

        <div class="form-field">
          <label for="confirmPassword">Confirm password</label>
          <input
            id="confirmPassword"
            name="confirmPassword"
            data-auth-field
            type="password"
            autocomplete="new-password"
            maxlength="128"
            aria-describedby="confirmPassword-error"
            aria-invalid="<%= errors?.confirmPassword ? "true" : "false" %>"
            required
          >
          <p class="field-error" id="confirmPassword-error" data-error-for="confirmPassword" aria-live="polite"<% if (!errors?.confirmPassword) { %> hidden<% } %>><%= errors?.confirmPassword ?? "" %></p>
        </div>

        <button class="button button--primary auth-submit" type="submit">Create account</button>
      </form>

      <p class="auth-switch">
        Already have an account?
        <a href="/auth/login">Log in</a>
      </p>
    </div>
  </section>
</div>

<%- include("../partials/footer") %>
