<%- include("../partials/header", {
  title: "Log in — mini drive",
  description: "Log in to your personal mini drive.",
  authPage: true
}) %>

<div class="auth-shell">
  <%- include("../partials/auth-visual", {
    authHeading: "Pick up where you left off.",
    authLead: "Your folders, previews, and share links are waiting."
  }) %>

  <section class="auth-panel" aria-labelledby="auth-title">
    <div class="auth-panel__inner">
      <a class="auth-back" href="/">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <path d="M19 12H5m0 0 6-6m-6 6 6 6"></path>
        </svg>
        Back to home
      </a>

      <p class="auth-kicker">Welcome back</p>
      <h1 id="auth-title">Log in to your drive.</h1>
      <p class="auth-lead">Enter your details to get back to your files.</p>

      <div class="form-alert" data-form-error role="alert" tabindex="-1"<% if (!errors?.form) { %> hidden<% } %>>
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <circle cx="12" cy="12" r="9"></circle>
          <path d="M12 8v5"></path>
          <path d="M12 16.5h.01"></path>
        </svg>
        <span data-form-error-text><%= errors?.form ?? "" %></span>
      </div>

      <form class="auth-form" action="/auth/login" method="post" data-auth-form="login" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="form-field">
          <label for="email">Email</label>
          <input
            id="email"
            name="email"
            data-auth-field
            type="email"
            autocomplete="email"
            spellcheck="false"
            autocapitalize="none"
            value="<%= values?.email ?? "" %>"
            aria-describedby="email-error"
            aria-invalid="<%= errors?.email ? "true" : "false" %>"
            required
          >
          <p class="field-error" id="email-error" data-error-for="email" aria-live="polite"<% if (!errors?.email) { %> hidden<% } %>><%= errors?.email ?? "" %></p>
        </div>

        <div class="form-field">
          <label for="password">Password</label>
          <input
            id="password"
            name="password"
            data-auth-field
            type="password"
            autocomplete="current-password"
            aria-describedby="password-error"
            aria-invalid="<%= errors?.password ? "true" : "false" %>"
            required
          >
          <p class="field-error" id="password-error" data-error-for="password" aria-live="polite"<% if (!errors?.password) { %> hidden<% } %>><%= errors?.password ?? "" %></p>
        </div>

        <button class="button button--primary auth-submit" type="submit">Log in</button>
      </form>

      <p class="auth-switch">
        Need an account?
        <a href="/auth/register">Create one</a>
      </p>
    </div>
  </section>
</div>

<%- include("../partials/footer") %>
