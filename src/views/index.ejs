<%- include("partials/header", {
  title: "mini drive — simple personal storage",
  description: "Upload, organize, find, and share your files in one calm personal drive.",
  landing: true
}) %>

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="eyebrow">
        <span class="eyebrow__dot" aria-hidden="true"></span>
        Personal storage, without the clutter
      </p>
      <h1 id="hero-title">Your files, in one calm place.</h1>
      <p class="hero__lead">
        Upload, organize, find, and share your files without the clutter.
        A simple personal drive for everyday storage.
      </p>
      <div class="hero__actions">
        <% if (currentUser) { %>
          <a class="button button--primary" href="/folders">Open my drive</a>
          <a class="button button--secondary" href="/search">Search my files</a>
        <% } else { %>
          <a class="button button--primary" href="/auth/register">Create your drive</a>
          <a class="button button--secondary" href="/auth/login">Log in</a>
        <% } %>
      </div>
      <ul class="hero__assurances" aria-label="Highlights">
        <li>
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <circle cx="12" cy="12" r="9"></circle>
            <path d="m8.5 12 2.3 2.3 4.7-5"></path>
          </svg>
          Private by default
        </li>
        <li>
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M12 16V4m0 0 4 4m-4-4L8 8"></path>
            <path d="M5 15v3a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-3"></path>
          </svg>
          Up to 10 files at once
        </li>
        <li>
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5Z"></path>
            <path d="M14 3v5h5"></path>
          </svg>
          5 MB per file
        </li>
      </ul>
    </div>

    <div class="hero__visual" aria-hidden="true">
      <div class="drive-window">
        <div class="drive-window__bar">
          <span class="drive-window__dots">
            <span></span>
            <span></span>
            <span></span>
          </span>
          <span class="drive-window__title">My drive</span>
          <span class="drive-window__avatar">J</span>
        </div>

        <div class="drive-window__search">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="6.5"></circle>
            <path d="m16 16 4 4"></path>
          </svg>
          <span>Search in drive</span>
          <span class="drive-window__shortcut">/</span>
        </div>

        <div class="drive-window__toolbar">
          <span class="drive-chip drive-chip--active">All files</span>
          <span class="drive-chip">Folders</span>
          <span class="drive-chip">Recent</span>
        </div>

        <div class="drive-window__grid">
          <div class="drive-card drive-card--folder">
            <span class="drive-card__icon drive-card__icon--yellow">
              <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 7.5A2.5 2.5 0 0 1 5.5 5h4l2 2.5h7A2.5 2.5 0 0 1 21 10v7.5a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 17.5v-10Z"></path>
              </svg>
            </span>
            <span>
              <span class="drive-card__name">Projects</span>
              <span class="drive-card__meta">4 items</span>
            </span>
          </div>

          <div class="drive-card drive-card--folder">
            <span class="drive-card__icon drive-card__icon--blue">
              <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 7.5A2.5 2.5 0 0 1 5.5 5h4l2 2.5h7A2.5 2.5 0 0 1 21 10v7.5a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 17.5v-10Z"></path>
              </svg>
            </span>
            <span>
              <span class="drive-card__name">Receipts</span>
              <span class="drive-card__meta">12 items</span>
            </span>
          </div>

          <div class="drive-card">
            <span class="drive-card__icon drive-card__icon--red">
              <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5Z"></path>
                <path d="M14 3v5h5"></path>
                <path d="M9 13h6M9 17h4"></path>
              </svg>
            </span>
            <span>
              <span class="drive-card__name">Notes.txt</span>
              <span class="drive-card__meta">2.4 KB</span>
            </span>
          </div>

          <div class="drive-card">
            <span class="drive-card__icon drive-card__icon--green">
              <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                <circle cx="8.5" cy="10" r="1.5"></circle>
                <path d="m21 16-5-5L7 19"></path>
              </svg>
            </span>
            <span>
              <span class="drive-card__name">Team photo.jpg</span>
              <span class="drive-card__meta">1.8 MB</span>
            </span>
          </div>
        </div>

        <div class="share-float">
          <span class="share-float__icon">
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M10 13.5a4 4 0 0 0 5.7 0l2.8-2.8a4 4 0 1 0-5.7-5.7L11.5 6.3"></path>
              <path d="M14 10.5a4 4 0 0 0-5.7 0l-2.8 2.8a4 4 0 1 0 5.7 5.7l1.3-1.3"></path>
            </svg>
          </span>
          <span>
            <strong>Share link</strong>
            <span>Expires in 7 days</span>
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="benefits" aria-labelledby="benefits-title">
  <div class="container">
    <h2 id="benefits-title" class="visually-hidden">What mini drive gives you</h2>
    <ul class="benefit-list">
      <li class="benefit">
        <span class="benefit__icon benefit__icon--blue">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M12 16V4m0 0 4 4m-4-4L8 8"></path>
            <path d="M5 15v3a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-3"></path>
          </svg>
        </span>
        <div>
          <h3>Up to 10 files at once</h3>
          <p>Add a whole batch without repeating the upload form.</p>
        </div>
      </li>
      <li class="benefit">
        <span class="benefit__icon benefit__icon--green">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"></path>
            <circle cx="12" cy="12" r="2.5"></circle>
          </svg>
        </span>
        <div>
          <h3>Preview in place</h3>
          <p>Open images, PDFs, and text files before you download them.</p>
        </div>
      </li>
      <li class="benefit">
        <span class="benefit__icon benefit__icon--yellow">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M10 13.5a4 4 0 0 0 5.7 0l2.8-2.8a4 4 0 1 0-5.7-5.7L11.5 6.3"></path>
            <path d="M14 10.5a4 4 0 0 0-5.7 0l-2.8 2.8a4 4 0 1 0 5.7 5.7l1.3-1.3"></path>
          </svg>
        </span>
        <div>
          <h3>Links that expire</h3>
          <p>Share a folder for a set number of days, then let it close.</p>
        </div>
      </li>
    </ul>
  </div>
</section>

<section class="section section--tint" id="features" aria-labelledby="features-title">
  <div class="container">
    <div class="section-heading">
      <p class="eyebrow">What you get</p>
      <h2 id="features-title">Simple tools for the files you use every day.</h2>
      <p>Keep your drive focused. No noisy extras, just the parts that help you find and share what matters.</p>
    </div>

    <div class="feature-grid">
      <article class="feature-card">
        <span class="feature-icon feature-icon--blue">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M3 7.5A2.5 2.5 0 0 1 5.5 5h4l2 2.5h7A2.5 2.5 0 0 1 21 10v7.5a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 17.5v-10Z"></path>
          </svg>
        </span>
        <h3>Folders that make sense</h3>
        <p>Create nested folders so related files stay together and easy to find.</p>
      </article>

      <article class="feature-card">
        <span class="feature-icon feature-icon--yellow">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M12 16V4m0 0 4 4m-4-4L8 8"></path>
            <path d="M5 15v3a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-3"></path>
          </svg>
        </span>
        <h3>Upload a batch</h3>
        <p>Add up to 10 files at once. Unsupported or duplicate files are skipped with a clear message.</p>
      </article>

      <article class="feature-card">
        <span class="feature-icon feature-icon--green">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <circle cx="11" cy="11" r="6.5"></circle>
            <path d="m16 16 4 4"></path>
          </svg>
        </span>
        <h3>Search the whole drive</h3>
        <p>Find folders and files by name, across every folder you own.</p>
      </article>

      <article class="feature-card">
        <span class="feature-icon feature-icon--blue">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"></path>
            <circle cx="12" cy="12" r="2.5"></circle>
          </svg>
        </span>
        <h3>Preview without downloading</h3>
        <p>Open images, PDFs, and plain text files directly in the app.</p>
      </article>

      <article class="feature-card">
        <span class="feature-icon feature-icon--red">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M10 13.5a4 4 0 0 0 5.7 0l2.8-2.8a4 4 0 1 0-5.7-5.7L11.5 6.3"></path>
            <path d="M14 10.5a4 4 0 0 0-5.7 0l-2.8 2.8a4 4 0 1 0 5.7 5.7l1.3-1.3"></path>
            <path d="M5 5l14 14"></path>
          </svg>
        </span>
        <h3>Share on your terms</h3>
        <p>Create a read-only link that expires after 1 to 365 days, and revoke it anytime.</p>
      </article>

      <article class="feature-card">
        <span class="feature-icon feature-icon--green">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M12 3v12m0 0 4-4m-4 4-4-4"></path>
            <path d="M5 20h14"></path>
          </svg>
        </span>
        <h3>Download when you need it</h3>
        <p>Grab the original file whenever you need it. Remote files are streamed through the app.</p>
      </article>
    </div>
  </div>
</section>

<section class="section" id="how-it-works" aria-labelledby="how-it-works-title">
  <div class="container">
    <div class="section-heading">
      <p class="eyebrow">How it works</p>
      <h2 id="how-it-works-title">Three steps from upload to share.</h2>
    </div>

    <ol class="steps">
      <li class="step">
        <span class="step__number">01</span>
        <h3>Create your account</h3>
        <p>Register with an email and password. Your drive is private to you.</p>
      </li>
      <li class="step">
        <span class="step__number">02</span>
        <h3>Upload and organize</h3>
        <p>Create folders, move files, and keep everything in the right place.</p>
      </li>
      <li class="step">
        <span class="step__number">03</span>
        <h3>Find and share</h3>
        <p>Search by name, preview a file, or send a read-only link that expires.</p>
      </li>
    </ol>
  </div>
</section>

<section class="section section--tint" id="privacy" aria-labelledby="privacy-title">
  <div class="container privacy">
    <div class="privacy__copy">
      <p class="eyebrow">Privacy</p>
      <h2 id="privacy-title">Private by default.</h2>
      <p class="privacy__lead">
        Your drive belongs to your account. Sharing is deliberate, and every
        share link can be limited and revoked.
      </p>
      <ul class="privacy__list">
        <li>
          <span class="privacy__check">
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <path d="m5 12 4 4L19 6"></path>
            </svg>
          </span>
          <span>Files and folders are tied to the account that owns them.</span>
        </li>
        <li>
          <span class="privacy__check">
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <path d="m5 12 4 4L19 6"></path>
            </svg>
          </span>
          <span>Share links expire after 1 to 365 days and can be revoked.</span>
        </li>
        <li>
          <span class="privacy__check">
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <path d="m5 12 4 4L19 6"></path>
            </svg>
          </span>
          <span>Remote files are streamed through the app, not exposed as direct browser URLs.</span>
        </li>
      </ul>
    </div>

    <div class="privacy__visual" aria-hidden="true">
      <div class="privacy__shield">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 3 5 6v5c0 4.5 3 7.8 7 10 4-2.2 7-5.5 7-10V6l-7-3Z"></path>
          <path d="m9 12 2 2 4-4"></path>
        </svg>
      </div>
      <span class="privacy__chip privacy__chip--top">Private by default</span>
      <span class="privacy__chip privacy__chip--bottom">Expires in 7 days</span>
    </div>
  </div>
</section>

<section class="cta-section" aria-labelledby="cta-title">
  <div class="container cta-panel">
    <div class="cta-panel__copy">
      <p class="eyebrow">Ready when you are</p>
      <h2 id="cta-title">Create an account and make it yours.</h2>
      <p>Start with an empty drive. Add folders, upload files, and share only what you choose.</p>
    </div>
    <div class="cta-panel__actions">
      <% if (currentUser) { %>
        <a class="button button--primary" href="/folders">Open my drive</a>
        <a class="button button--secondary" href="/search">Search my files</a>
      <% } else { %>
        <a class="button button--primary" href="/auth/register">Create your drive</a>
        <a class="button button--secondary" href="/auth/login">Log in</a>
      <% } %>
    </div>
  </div>
</section>

<%- include("partials/footer") %>
