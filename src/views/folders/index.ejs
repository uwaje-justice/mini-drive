<%- include("../partials/header", { title: "My drive" }) %>
<h1>My drive</h1>
<p><a href="/folders/new">New folder</a></p>

<section>
  <h2>Folders</h2>
  <%- include("../partials/folder-list", { folders }) %>
  <%- include("../partials/pagination", { pagination: folderPagination, paramName: "folderPage", basePath: "/folders", label: "Folder pages" }) %>
</section>

<section>
  <h2>Files</h2>
  <%- include("../partials/file-list", { files }) %>
  <%- include("../partials/pagination", { pagination: filePagination, paramName: "page", basePath: "/folders", label: "File pages" }) %>
</section>

<section>
  <h2>Upload a file</h2>
  <% if (typeof uploadErrors !== "undefined" && uploadErrors.length > 0) { %>
    <ul role="alert">
      <% uploadErrors.forEach((message) => { %>
        <li><%= message %></li>
      <% }); %>
    </ul>
  <% } %>
  <form action="/files/upload" method="post" enctype="multipart/form-data">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div>
      <label for="files">Files</label>
      <input id="files" name="files" type="file" accept=".png,.jpg,.jpeg,.webp,.gif,.pdf,.txt" multiple required>
    </div>
    <button type="submit">Upload</button>
  </form>
</section>

<%- include("../partials/footer") %>
