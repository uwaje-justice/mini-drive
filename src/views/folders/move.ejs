<%- include("../partials/header", { title: `Move ${folder.name}` }) %>

<div class="form-page">
  <a class="back-link" href="/folders/<%= folder.id %>">
    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="m15 6-6 6 6 6"></path>
    </svg>
    Back
  </a>

  <div class="page-header">
    <div>
      <p class="eyebrow">Folder settings</p>
      <h1>Move folder</h1>
      <p class="page-header__meta">Choose a new parent for "<%= folder.name %>".</p>
    </div>
  </div>

  <section class="panel form-panel">
    <% if (errors?.parentId) { %>
      <p class="form-alert" role="alert">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <circle cx="12" cy="12" r="9"></circle>
          <path d="M12 7.5v5.5M12 16.5h.01"></path>
        </svg>
        <span><%= errors.parentId %></span>
      </p>
    <% } %>

    <form class="form" action="" method="post" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-field">
        <label for="parentId">Destination</label>
        <select id="parentId" name="parentId"<% if (errors?.parentId) { %> aria-invalid="true" aria-describedby="parent-error"<% } %>>
          <% targets.forEach((target) => { %>
            <option value="<%= target.id ?? "" %>" <%= String(target.id ?? "") === String(values?.parentId ?? "") ? "selected" : "" %>>
              <%= `${"— ".repeat(target.depth)}${target.path}` %>
            </option>
          <% }); %>
        </select>
        <% if (errors?.parentId) { %><p class="field-error" id="parent-error"><%= errors.parentId %></p><% } %>
      </div>
      <div class="form-actions">
        <button class="button button--primary" type="submit">Move</button>
        <a class="text-button" href="/folders/<%= folder.id %>">Cancel</a>
      </div>
    </form>
  </section>
</div>

<%- include("../partials/footer") %>
