<%- include("../partials/header", { title: "New folder" }) %>
<h1>New folder</h1>
<% if (errors?.name) { %><p role="alert"><%= errors.name %></p><% } %>
<form action="/folders" method="post" novalidate>
  <input type="hidden" name="parentId" value="<%= values?.parentId ?? "" %>">
  <div>
    <label for="name">Folder name</label>
    <input id="name" name="name" type="text" maxlength="100" value="<%= values?.name ?? "" %>" required>
  </div>
  <button type="submit">Create folder</button>
</form>
<p><a href="/folders">Cancel</a></p>
<%- include("../partials/footer") %>
