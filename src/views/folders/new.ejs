<%- include("../partials/header", { title: "New folder" }) %>

<% const cancelHref = values?.parentId ? `/folders/${values.parentId}` : "/folders"; %>

<div class="form-page">
  <a class="back-link" href="<%= cancelHref %>">
    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="m15 6-6 6 6 6"></path>
    </svg>
    Back
  </a>

  <div class="page-header">
    <div>
      <p class="eyebrow">Organize your drive</p>
      <h1>New folder</h1>
      <p class="page-header__meta">Give the folder a clear name you will recognize later.</p>
    </div>
  </div>

  <section class="panel form-panel">
    <% if (errors?.name) { %>
      <p class="form-alert" role="alert">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <circle cx="12" cy="12" r="9"></circle>
          <path d="M12 7.5v5.5M12 16.5h.01"></path>
        </svg>
        <span><%= errors.name %></span>
      </p>
    <% } %>

    <form class="form" action="/folders" method="post" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="parentId" value="<%= values?.parentId ?? "" %>">
      <div class="form-field">
        <label for="name">Folder name</label>
        <input id="name" name="name" type="text" maxlength="100" value="<%= values?.name ?? "" %>" required<% if (errors?.name) { %> aria-invalid="true" aria-describedby="name-error"<% } %>>
        <% if (errors?.name) { %><p class="field-error" id="name-error"><%= errors.name %></p><% } %>
      </div>
      <div class="form-actions">
        <button class="button button--primary" type="submit">Create folder</button>
        <a class="text-button" href="<%= cancelHref %>">Cancel</a>
      </div>
    </form>
  </section>
</div>

<%- include("../partials/footer") %>
