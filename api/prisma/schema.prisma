datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output = "../src/generated/prisma"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  folders      Folder[]
  files        File[]
  activities   Activity[]
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime
}

model Folder {
  id        String   @id @default(cuid())
  name      String
  nameKey   String
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  parentId  String?
  parentKey String
  parent    Folder?  @relation("FolderChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children   Folder[]    @relation("FolderChildren")
  files      File[]
  shareLinks ShareLink[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([ownerId, parentKey, nameKey])
  @@index([ownerId, parentId])
}

model File {
  id                  String   @id @default(cuid())
  name                String
  nameKey             String
  storageProvider     String   @default("local")
  storageKey          String   @unique
  storageUrl          String?
  storageFormat       String?
  storageResourceType String?
  mimeType            String
  size                Int
  ownerId             String
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  folderId   String?
  folderKey  String
  folder     Folder?  @relation(fields: [folderId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([ownerId, folderKey, nameKey])
  @@index([ownerId, folderId])
}

model Activity {
  id               String   @id @default(cuid())
  ownerId          String
  owner            User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  action           String
  targetType       String
  targetId         String?
  targetName       String
  previousName     String?
  previousEmail    String?
  nextEmail        String?
  locationName     String?
  fromLocationName String?
  toLocationName   String?
  createdAt        DateTime @default(now())

  @@index([ownerId, createdAt])
}

model ShareLink {
  id        String   @id @default(cuid())
  token     String   @unique
  folderId  String
  folder    Folder   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([folderId])
}
