    "@quixo3/prisma-session-store": "^3.1.21",
    "argon2": "^0.45.1",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "csrf-sync": "^4.2.1",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "express-validator": "^7.3.2",
    "multer": "^2.5.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pg": "^8.23.1",
