{
  "name": "@file-uploader/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "db:test:reset": "NODE_ENV=test prisma migrate reset --force --skip-seed",
    "pretest": "npm run db:test:reset",
    "test": "NODE_ENV=test SESSION_SECRET=test-secret STORAGE_DRIVER=local CLIENT_ORIGINS=http://localhost:5173 vitest run",
    "test:watch": "NODE_ENV=test SESSION_SECRET=test-secret STORAGE_DRIVER=local CLIENT_ORIGINS=http://localhost:5173 vitest",
    "dev": "nodemon ./src/server.js",
    "start": "node ./src/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prisma:migrate": "prisma migrate dev",
    "postprisma:migrate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio"
  },
  "keywords": [],
