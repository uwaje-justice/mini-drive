datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
  output = "../src/generated/prisma"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime
}
