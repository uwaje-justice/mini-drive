{
  "name": "file-uploader",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "api",
    "client"
  ],
  "scripts": {
    "dev": "concurrently --kill-others --names api,client --prefix-colors blue,magenta \"npm run dev -w @file-uploader/api\" \"npm run dev -w @file-uploader/client\"",
    "dev:api": "npm run dev -w @file-uploader/api",
    "dev:client": "npm run dev -w @file-uploader/client",
    "build": "npm run build -w @file-uploader/client",
    "start": "npm run start -w @file-uploader/api",
    "test": "npm run test -w @file-uploader/api",
    "test:watch": "npm run test:watch -w @file-uploader/api",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prisma:migrate": "npm run prisma:migrate -w @file-uploader/api",
    "prisma:generate": "npm run prisma:generate -w @file-uploader/api",
    "prisma:studio": "npm run prisma:studio -w @file-uploader/api"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.13.0"
  }
}
